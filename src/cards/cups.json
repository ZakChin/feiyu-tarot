[
  {
    "id": "cups-1",
    "arcana": "minor",
    "suit": "cups",
    "rank": 1,
    "name": "圣杯一",
    "nameEn": "Ace of Cups",
    "keywords": { "upright": ["情感萌芽", "柔软", "直觉"], "reversed": ["情绪堵塞", "先承认", "自我滋养"] },
    "fortune": { "upright": "good", "reversed": "neutral" },
    "text": {
      "upright": "情感的水面开始流动，你可能对某个人或某件事突然有了柔软的感觉。别急着分析，先把这份感受写下来或说出来，让它有出口。",
      "reversed": "情绪堵在里面，你习惯说没事。今天给自己倒一杯水，安静十分钟，先承认你在难受；被看见的感受才流动得起来。"
    }
  },
  {
    "id": "cups-2",
    "arcana": "minor",
    "suit": "cups",
    "rank": 2,
    "name": "圣杯二",
    "nameEn": "Two of Cups",
    "keywords": { "upright": ["相互靠近", "对等", "连接"], "reversed": ["失衡", "单方付出", "说清需求"] },
    "fortune": { "upright": "good", "reversed": "shadow" },
    "text": {
      "upright": "一段关系里出现了真实的靠近。别用试探代替表达，直接告诉对方你在意什么；对等的回应，才是这段连接能走下去的基础。",
      "reversed": "付出和回应不太对等，你开始委屈。先别下结论，把需求讲清楚一次；对方愿意调整，关系就还有空间。"
    }
  },
  {
    "id": "cups-3",
    "arcana": "minor",
    "suit": "cups",
    "rank": 3,
    "name": "圣杯三",
    "nameEn": "Three of Cups",
    "keywords": { "upright": ["相聚", "分享", "互相支持"], "reversed": ["社交耗竭", "维持表面", "留一人深聊"] },
    "fortune": { "upright": "good", "reversed": "neutral" },
    "text": {
      "upright": "和喜欢的人待在一起，本身就是一种补给。今天约一顿简单的饭，别谈工作，聊聊近况；被理解的感觉会帮你恢复力气。",
      "reversed": "社交太多反而更空。你可能在维持一些并不滋养你的关系；推掉一场应酬，把时间留给一个真正想深聊的人。"
    }
  },
  {
    "id": "cups-4",
    "arcana": "minor",
    "suit": "cups",
    "rank": 4,
    "name": "圣杯四",
    "nameEn": "Four of Cups",
    "keywords": { "upright": ["提不起劲", "错过邀请", "停滞"], "reversed": ["重拾兴趣", "接住邀请", "走出去"] },
    "fortune": { "upright": "neutral", "reversed": "good" },
    "text": {
      "upright": "机会递到你面前，你却提不起劲。先别急着拒绝，问自己是真的不想要，还是只是累了；休息够了，答案会不一样。",
      "reversed": "你开始重新对某件事有兴趣，这是好兆头。接住那个小小的邀请，哪怕只去半小时；兴趣是靠行动重新点亮的。"
    }
  },
  {
    "id": "cups-5",
    "arcana": "minor",
    "suit": "cups",
    "rank": 5,
    "name": "圣杯五",
    "nameEn": "Five of Cups",
    "keywords": { "upright": ["失落", "遗憾", "看见剩余"], "reversed": ["转身", "退潮", "照顾自己"] },
    "fortune": { "upright": "shadow", "reversed": "good" },
    "text": {
      "upright": "失去的东西确实让人难过，允许自己难过一会儿。但别只盯着倒掉的那部分，清点一下手里还剩什么，那里有你重新开始的材料。",
      "reversed": "你慢慢转过身来了。把注意力从遗憾移到尚存的人和事上，做一件具体的小事照顾自己；悲伤不会一下消失，但会开始退潮。"
    }
  },
  {
    "id": "cups-6",
    "arcana": "minor",
    "suit": "cups",
    "rank": 6,
    "name": "圣杯六",
    "nameEn": "Six of Cups",
    "keywords": { "upright": ["旧日温暖", "纯粹", "被爱过"], "reversed": ["沉溺过去", "分清怀旧", "按当下决定"] },
    "fortune": { "upright": "good", "reversed": "neutral" },
    "text": {
      "upright": "旧人旧事带来温暖，也提醒你曾经被好好爱过。可以联系一位老朋友，但别把回忆当成现在的答案；怀旧是补给，不是退路。",
      "reversed": "你可能在用过去逃避现在。分清怀念和回退：温度可以保留，决定要按当下的情况做，别为了熟悉而留在不合适的地方。"
    }
  },
  {
    "id": "cups-7",
    "arcana": "minor",
    "suit": "cups",
    "rank": 7,
    "name": "圣杯七",
    "nameEn": "Seven of Cups",
    "keywords": { "upright": ["幻想", "选项过多", "迷雾"], "reversed": ["雾散", "选定一个", "落地"] },
    "fortune": { "upright": "shadow", "reversed": "good" },
    "text": {
      "upright": "你眼前的选项太多，反而一个都抓不住。把脑海里的幻想写下来，逐条问一句这是想要还是想象；留下一个能本周落地的，先去试。",
      "reversed": "雾开始散了，你终于看清哪个选项是真的。别再收集更多可能性，选一个开始做；落地之后，路自然会显出细节。"
    }
  },
  {
    "id": "cups-8",
    "arcana": "minor",
    "suit": "cups",
    "rank": 8,
    "name": "圣杯八",
    "nameEn": "Eight of Cups",
    "keywords": { "upright": ["离开", "寻找意义", "承认不足"], "reversed": ["还没走", "弄清理由", "不急着定"] },
    "fortune": { "upright": "neutral", "reversed": "neutral" },
    "text": {
      "upright": "有些东西已经给不了你想要的了。承认这一点需要勇气，但离开不等于失败；先想清楚你要去找什么，再决定走多远。",
      "reversed": "你还没走，也还没留得安心。别急着做决定，先弄清楚你留下的真实理由；想明白了，走或留都会轻松一些。"
    }
  },
  {
    "id": "cups-9",
    "arcana": "minor",
    "suit": "cups",
    "rank": 9,
    "name": "圣杯九",
    "nameEn": "Nine of Cups",
    "keywords": { "upright": ["满足", "愿望达成", "享受"], "reversed": ["空落", "愿望外包", "问清所需"] },
    "fortune": { "upright": "good", "reversed": "shadow" },
    "text": {
      "upright": "你期待的东西正在到位，值得好好享受。但别把满足感全部押在结果上，做一件让自己舒服的事，记住此刻的感觉。",
      "reversed": "得到之后反而空落，说明你要的不止这些。别急着用新目标填坑，先问自己真正想要的是什么，愿望才不会被外包出去。"
    }
  },
  {
    "id": "cups-10",
    "arcana": "minor",
    "suit": "cups",
    "rank": 10,
    "name": "圣杯十",
    "nameEn": "Ten of Cups",
    "keywords": { "upright": ["圆满", "关系暖意", "归属"], "reversed": ["理想压力", "真实沟通", "不假装和睦"] },
    "fortune": { "upright": "good", "reversed": "neutral" },
    "text": {
      "upright": "你身边关系里的暖意正在聚拢，适合把家人或亲近的人聚在一起。别追求完美的场面，真实的相处比好看的画面更能留住人。",
      "reversed": "理想的关系画面给了你压力。别拿别人的模板衡量自己的家，把真实的困难说出来；一起面对比假装和睦更有用。"
    }
  },
  {
    "id": "cups-11",
    "arcana": "minor",
    "suit": "cups",
    "rank": 11,
    "name": "圣杯侍从",
    "nameEn": "Page of Cups",
    "keywords": { "upright": ["敏感", "灵感", "温柔的念头"], "reversed": ["情绪化", "先睡好", "落地表达"] },
    "fortune": { "upright": "good", "reversed": "neutral" },
    "text": {
      "upright": "你心里冒出一个小小的灵感或温柔念头，别嫌它幼稚。把它做成一件具体的小事，比如一张卡片、一段旋律，情绪需要出口。",
      "reversed": "你最近容易被情绪牵着走，一点小事就翻涌。先照顾睡眠和饮食，再决定要不要回应；等情绪落地，判断会清楚很多。"
    }
  },
  {
    "id": "cups-12",
    "arcana": "minor",
    "suit": "cups",
    "rank": 12,
    "name": "圣杯骑士",
    "nameEn": "Knight of Cups",
    "keywords": { "upright": ["浪漫", "追随心意", "邀请"], "reversed": ["幻想投射", "分清想象", "说出期待"] },
    "fortune": { "upright": "good", "reversed": "shadow" },
    "text": {
      "upright": "有人带着好意靠近，或者你心里有想表达的感情。别只停在想象里，把心意用行动递出去；真诚的邀请值得被说出口。",
      "reversed": "你可能爱上了自己想象中的样子。先分清幻想和真实的人，把期待说清楚，也听听对方的需求；落地之后，感情才有根。"
    }
  },
  {
    "id": "cups-13",
    "arcana": "minor",
    "suit": "cups",
    "rank": 13,
    "name": "圣杯王后",
    "nameEn": "Queen of Cups",
    "keywords": { "upright": ["共情", "直觉", "照顾"], "reversed": ["情绪淹没", "模糊界限", "先顾自己"] },
    "fortune": { "upright": "good", "reversed": "shadow" },
    "text": {
      "upright": "你的共情力很强，能接住别人的情绪。但记得也照顾自己：先问问自己现在需要什么，再决定要不要当那个倾听的人。",
      "reversed": "你被别人的情绪淹没了，界限变得模糊。今天少接一个情绪电话，把注意力收回到自己身上；照顾自己不是自私。"
    }
  },
  {
    "id": "cups-14",
    "arcana": "minor",
    "suit": "cups",
    "rank": 14,
    "name": "圣杯国王",
    "nameEn": "King of Cups",
    "keywords": { "upright": ["情绪成熟", "稳住", "包容"], "reversed": ["压抑情绪", "内部涨潮", "说出来"] },
    "fortune": { "upright": "good", "reversed": "shadow" },
    "text": {
      "upright": "情绪成熟是你现在最大的资源。遇到波动时先稳住自己，再回应别人；你的平静会让身边的人也安定下来。",
      "reversed": "你把情绪压得太深，表面平静，里面在涨。找一个安全的人说出来，或者写下来；情绪被承认，才不会在别处爆发。"
    }
  }
]
